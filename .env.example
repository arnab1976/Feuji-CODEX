# Copy to .env and adjust. All variables are optional.
CODEX_DATABASE_URL=sqlite:////data/codex.db
# CODEX_DATABASE_URL=postgresql+psycopg://codex:codex@db:5432/codex   (add psycopg[binary] to requirements)
CODEX_CORS_ORIGINS=*
CODEX_DEFAULT_THRESHOLD=0.90

# Agent modes: rules (built-in demo engine) | production (plug real services, see backend/app/agents)
CODEX_OCR_MODE=rules
CODEX_NER_MODE=rules
CODEX_CODER_MODE=rules
CODEX_LLM_PROVIDER=
CODEX_LLM_MODEL=
CODEX_LLM_API_KEY=

# Patient 360: server-side delivery of codex:result (optional)
CODEX_PATIENT360_WEBHOOK_URL=
CODEX_PATIENT360_WEBHOOK_TOKEN=
